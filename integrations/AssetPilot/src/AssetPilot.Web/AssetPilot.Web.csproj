<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>AssetPilot</AssemblyName>
    <RootNamespace>AssetPilot.Web</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>3.7.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AssetPilot.Application\AssetPilot.Application.csproj" />
    <ProjectReference Include="..\AssetPilot.Domain\AssetPilot.Domain.csproj" />
    <ProjectReference Include="..\AssetPilot.Infrastructure\AssetPilot.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="SeedData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

