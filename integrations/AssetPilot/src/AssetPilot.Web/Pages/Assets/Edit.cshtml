@page
@model AssetPilot.Web.Pages.Assets.EditModel
@{
    ViewData["Title"] = "Edit Asset";
    ViewData["Section"] = "Assets";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">ASSET INVENTORY</p>
        <h1>Edit asset</h1>
        <p class="muted">Update the complete inventory record and connected equipment.</p>
    </div>
</div>
<form method="post" class="editor-layout">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Version" type="hidden" />
    <div class="editor-main">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <partial name="_AssetForm" for="Input" />
    </div>
    <aside class="action-panel">
        <p class="eyebrow">ACTIONS</p>
        <button class="button primary full" type="submit">Save changes</button>
        <a class="button secondary full" asp-page="Details" asp-route-id="@Model.Id">Cancel</a>
    </aside>
</form>
