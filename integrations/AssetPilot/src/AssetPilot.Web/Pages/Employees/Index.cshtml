@page
@model AssetPilot.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
    ViewData["Section"] = "Employees";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">ADMINISTRATION</p>
        <h1>Employees</h1>
        <p class="muted">Active employees are protected from deletion. Disable and return assigned assets first.</p>
    </div>
    <a class="button primary" asp-page="Create">Add employee</a>
</div>
<section class="panel">
    <form method="get" class="filter-bar">
        <label class="search-field"><span>⌕</span><input asp-for="Query" placeholder="Partial name, email, employee number, or department" /></label>
        <label class="checkbox-filter"><input asp-for="ShowInactive" /> Include disabled</label>
        <button class="button secondary" type="submit">Apply filters</button>
        <a class="button ghost" asp-page="Index">Clear filters</a>
    </form>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Employee</th><th>Employee ID</th><th>Department</th><th>Location</th><th>Assigned assets</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr data-href="@Url.Page("Details", new { id = employee.Id })" tabindex="0">
                    <td><a class="asset-link" asp-page="Details" asp-route-id="@employee.Id">@employee.Name</a><small>@employee.Email</small></td>
                    <td>@employee.Number</td>
                    <td>@(employee.Department ?? "—")</td>
                    <td>@(employee.Location ?? "—")</td>
                    <td>@employee.AssignedAssets</td>
                    <td><span class="status-chip @(employee.IsActive ? "active" : "retired")">@(employee.IsActive ? "Active" : "Disabled")</span></td>
                    <td>
                        @if (!employee.IsActive)
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@employee.Id" class="inline-form" onsubmit="return confirm('Delete this disabled employee? Assignment history will be preserved.');">
                                <button class="button danger-outline" type="submit">Delete</button>
                            </form>
                        }
                        else
                        {
                            <a class="row-action" asp-page="Details" asp-route-id="@employee.Id">›</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Employees.Count == 0) { <div class="empty-state compact"><p>No employees match these filters.</p></div> }
    </div>
</section>
