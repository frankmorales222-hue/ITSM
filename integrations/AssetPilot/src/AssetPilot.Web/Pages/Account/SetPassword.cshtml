@page
@model AssetPilot.Web.Pages.Account.SetPasswordModel
@{ Layout = null; ViewData["Title"] = "Create password"; }
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Create password · AssetPilot</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body class="auth-body"><main class="auth-card"><div class="auth-brand">◆ AssetPilot</div><p class="eyebrow">ACCOUNT INVITATION</p><h1>Create your password</h1><p class="muted">Use at least 12 characters. You will use your email address to sign in.</p><div asp-validation-summary="All" class="validation"></div><form method="post" class="form-stack"><input asp-for="UserId" type="hidden" /><input asp-for="Code" type="hidden" /><label>New password<input asp-for="Password" type="password" autocomplete="new-password" /></label><label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></label><button class="button primary full" type="submit">Create password</button></form></main></body></html>
