  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:test": "psql \"$TEST_DATABASE_URL\" -f migrations/001_init.sql && psql \"$TEST_DATABASE_URL\" -f migrations/002_add_password.sql && psql \"$TEST_DATABASE_URL\" -f migrations/003_add_password_setup_token.sql",
