ITSM_ENVIRONMENT=production
ITSM_DATABASE_URL=postgresql+psycopg://itsm_service:CHANGE_ME@127.0.0.1:5432/northstar_desk
ITSM_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
ITSM_SESSION_MINUTES=480
ITSM_COOKIE_SECURE=true
ITSM_PUBLIC_URL=https://helpdesk.example.org
ITSM_ALLOWED_ORIGINS=https://helpdesk.example.org
ITSM_TRUSTED_HOSTS=helpdesk.example.org
ITSM_FORWARDED_ALLOW_IPS=127.0.0.1
ITSM_BIND_HOST=127.0.0.1
ITSM_PORT=8000
ITSM_OUTBOUND_EMAIL_ENABLED=false
ITSM_ASSETPILOT_ENABLED=false
ITSM_BACKUP_DIRECTORY=D:/NorthstarDesk/backups
ITSM_UPDATE_PUBLIC_KEY=
ITSM_UPDATE_STAGING_DIRECTORY=D:/NorthstarDesk/updates
ITSM_UPDATE_MAX_PACKAGE_MB=512
ITSM_ASSETPILOT_URL=https://assets.example.org
ITSM_ASSETPILOT_INTERNAL_URL=http://127.0.0.1:5080
ITSM_ASSETPILOT_EXECUTABLE=C:/Program Files/Northstar Desk/AssetPilot/AssetPilot.exe
ITSM_ASSETPILOT_SYNC_MINUTES=5
ITSM_SMTP_HOST=
ITSM_SMTP_PORT=587
ITSM_SMTP_USERNAME=
ITSM_SMTP_FROM=
ITSM_SMTP_USE_TLS=true
ITSM_SMTP_SECRET_TARGET=NorthstarDesk/smtp
ITSM_MICROSOFT_CLIENT_ID=
ITSM_MICROSOFT_CLIENT_SECRET=
ITSM_RINGCENTRAL_CLIENT_ID=
ITSM_RINGCENTRAL_CLIENT_SECRET=
ITSM_RINGCENTRAL_ENVIRONMENT=production
