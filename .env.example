ITSM_DATABASE_URL=sqlite:///./data/itsm.db
ITSM_SECRET_KEY=replace-with-at-least-32-random-characters
ITSM_SESSION_MINUTES=480
ITSM_COOKIE_SECURE=false
ITSM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ITSM_APP_VERSION=0.1.0
ITSM_ASSETPILOT_URL=http://127.0.0.1:5080
# Optional overrides; Windows defaults are detected automatically.
ITSM_ASSETPILOT_EXECUTABLE=
ITSM_ASSETPILOT_DATABASE_PATH=
# PostgreSQL production example:
# ITSM_DATABASE_URL=postgresql+psycopg://itsm_user:password@localhost:5432/itsm
# Optional Windows Credential Manager target used for encrypted mailbox credentials:
# ITSM_MAIL_SECRET_TARGET=NorthstarDesk/imap
