DATABASE_URL=postgresql://user:password@localhost:5432/itsm
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the session cookie (see src/lib/session.ts). Any long random value;
# rotating it invalidates all existing sessions.
SESSION_SECRET=

# Shared secret the email-intake webhook (src/app/api/email/inbound) checks
# via the x-webhook-secret header. Whatever calls that route (a scheduled
# job, a provider's inbound-parse webhook) needs to send this value.
EMAIL_WEBHOOK_SECRET=

# Backs the login rate limiter (src/lib/rate-limit.ts) so it works across
# multiple app instances instead of just the current process.
REDIS_URL=redis://localhost:6379

# S3-compatible attachment storage (src/lib/attachments.ts). Defaults below
# match the local MinIO container — see README for the docker run command.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=itsm-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
