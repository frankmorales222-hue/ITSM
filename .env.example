ITSM_DATABASE_URL=sqlite:///./data/itsm.db
ITSM_ENVIRONMENT=development
ITSM_SECRET_KEY=replace-with-at-least-32-random-characters
ITSM_SESSION_MINUTES=480
ITSM_COOKIE_SECURE=false
ITSM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ITSM_PUBLIC_URL=http://127.0.0.1:8000
ITSM_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
ITSM_FORWARDED_ALLOW_IPS=127.0.0.1
ITSM_BIND_HOST=127.0.0.1
ITSM_OUTBOUND_EMAIL_ENABLED=false
ITSM_ASSETPILOT_ENABLED=false
ITSM_BACKUP_DIRECTORY=data/backups
ITSM_UPDATE_PUBLIC_KEY=
ITSM_UPDATE_STAGING_DIRECTORY=data/updates
ITSM_UPDATE_MAX_PACKAGE_MB=512
ITSM_ASSETPILOT_URL=http://127.0.0.1:5080
ITSM_ASSETPILOT_INTERNAL_URL=http://127.0.0.1:5080
# Optional overrides; Windows defaults are detected automatically.
ITSM_ASSETPILOT_EXECUTABLE=
ITSM_ASSETPILOT_DATABASE_PATH=
# PostgreSQL production example:
# ITSM_DATABASE_URL=postgresql+psycopg://itsm_user:password@localhost:5432/itsm
# ITSM_ENVIRONMENT=production
# ITSM_COOKIE_SECURE=true
# ITSM_PUBLIC_URL=https://helpdesk.example.org
# ITSM_ALLOWED_ORIGINS=https://helpdesk.example.org
# ITSM_TRUSTED_HOSTS=helpdesk.example.org
# Set this to the private IP of the HTTPS reverse proxy, never an unrestricted wildcard.
# ITSM_FORWARDED_ALLOW_IPS=127.0.0.1
# Optional Windows Credential Manager target used for encrypted mailbox credentials:
# ITSM_MAIL_SECRET_TARGET=NorthstarDesk/imap
# Approval and notification email delivery (password stays in Windows Credential Manager):
# ITSM_SMTP_HOST=smtp.example.org
# ITSM_SMTP_PORT=587
# ITSM_SMTP_USERNAME=helpdesk@example.org
# ITSM_SMTP_FROM=helpdesk@example.org
# ITSM_SMTP_USE_TLS=true
# ITSM_SMTP_SECRET_TARGET=NorthstarDesk/smtp

# One-time provider app registrations. Customer administrators use browser
# consent and never enter their passwords in Northstar Desk.
ITSM_MICROSOFT_CLIENT_ID=
ITSM_MICROSOFT_CLIENT_SECRET=
ITSM_RINGCENTRAL_CLIENT_ID=
ITSM_RINGCENTRAL_CLIENT_SECRET=
ITSM_RINGCENTRAL_ENVIRONMENT=production
